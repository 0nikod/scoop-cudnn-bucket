{
  "version": "9.28.1.4",
  "description": "NVIDIA CUDA Deep Neural Network library (cuDNN) for CUDA 12 on Windows x86_64.",
  "homepage": "https://developer.nvidia.com/cudnn",
  "license": {
    "identifier": "NVIDIA-cuDNN",
    "url": "https://docs.nvidia.com/deeplearning/cudnn/sla/index.html"
  },
  "architecture": {
    "64bit": {
      "url": "https://developer.download.nvidia.com/compute/cudnn/redist/cudnn/windows-x86_64/cudnn-windows-x86_64-9.28.1.4_cuda12-archive.zip",
      "hash": "75bf8c4201adfe994213ac080b97ecba0e04ee86be10c1774982e837bee3ee8f",
      "extract_dir": "cudnn-windows-x86_64-9.28.1"
    }
  },
  "env_add_path": "bin\\x64",
  "env_set": {
    "CUDNN_HOME": "$dir"
  },
  "post_install": [
    "Write-Host 'cuDNN has been installed to:' $dir",
    "Write-Host 'CUDNN_HOME is set to:' $dir",
    "Write-Host 'bin\\x64 has been added to PATH for DLL discovery.'"
  ],
  "checkver": {
    "script": [
      "$root = 'https://developer.download.nvidia.com/compute/cudnn/redist/'",
      "$index = Invoke-RestMethod $root",
      "$labels = [regex]::Matches($index, 'redistrib_([0-9]+(?:\\.[0-9]+)+)\\.json') | ForEach-Object { $_.Groups[1].Value } | Sort-Object { [version]$_ } -Descending",
      "foreach ($label in $labels) {",
      "  $j = Invoke-RestMethod ($root + 'redistrib_' + $label + '.json')",
      "  if ($j.cudnn.'windows-x86_64'.cuda12) { $j.cudnn.version; break }",
      "}"
    ]
  },
  "notes": [
    "This package installs cuDNN headers, import libraries, DLLs, and LICENSE under Scoop's app directory.",
    "Most build systems can use CUDNN_HOME, include, lib\\x64, and bin\\x64 directly.",
    "If an application requires DLLs next to CUDA Toolkit binaries, copy the DLLs manually instead of overwriting files blindly."
  ]
}

